{
  "name": "openbyok",
  "displayName": "MultiProvider x OpenCode BYOK",
  "description": "Register models as VS Code BYOK (Bring Your Own Key) from OpenCode API linked to different providers (OpenAI, Azure OpenAI, Anthropic, Google Gemini, etc.)",
  "version": "0.1.0",
  "publisher": "qentah",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "OpenBYOK",
      "properties": {
        "openbyok.commitModel": {
          "type": "string",
          "default": "",
          "description": "Identifiant du modèle OpenCode utilisé pour générer le message de commit (ex: poolside/laguna-xs-2.1). Laisser vide pour utiliser le premier modèle du cache de benchmark."
        }
      }
    },
    "commands": [
      { "command": "openbyok.registerToken", "title": "OpenBYOK: Register API Token (st_…)" },
      { "command": "openbyok.selectModels", "title": "OpenBYOK: Select Models for BYOK" },
      { "command": "openbyok.configureApiKey", "title": "OpenBYOK: Configure Group API Key (native)" },
      { "command": "openbyok.refreshToken", "title": "OpenBYOK: Refresh Token" },
      { "command": "openbyok.logout", "title": "OpenBYOK: Logout" },
      { "command": "openbyok.runBenchmark", "title": "OpenBYOK: Run Benchmark (with progress)" },
      { "command": "openbyok.clearCache", "title": "OpenBYOK: Clear Benchmark Cache" },
      { "command": "opengit.generateCommitMessage", "title": "OpenGIT: Générer un message de commit", "icon": "$(git-commit)" }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "openbyok",
        "displayName": "OpenBYOK",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "OpenBYOK API Key",
              "description": "Enter your OpenCode key (oc_sk_…). Stored natively by VS Code.",
              "secret": true
            }
          }
        }
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "opengit.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  }
}